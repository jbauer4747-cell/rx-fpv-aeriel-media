{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/drone-property-documentation",
      "destination": "/services/drone-property-documentation",
      "permanent": true
    },
    {
      "source": "/construction-progress",
      "destination": "/services/construction-progress",
      "permanent": true
    },
    {
      "source": "/fpv-flythroughs",
      "destination": "/services/fpv-flythroughs",
      "permanent": true
    }
  ]
}
